[ghq]
	root = ~/Code
[core]
	quotepath = false
[push]
	default = simple
[diff]
	compactionHeuristic = true
	tool = vimdiff
[difftool]
	prompt = false
[merge]
	tool = vimdiff
[mergetool]
	prompt = false
	keepBackup = false
[fetch]
	prune = true
[include]
	path = ~/.gitconfig.local
[credential "https://github.com"]
	helper =
	helper = !gh auth git-credential
[credential "https://gist.github.com"]
	helper =
	helper = !gh auth git-credential
